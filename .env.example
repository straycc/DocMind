# 复制为项目根目录的 .env，填写实际地址和凭据。不要提交 .env。
# Spring 按 Properties 格式读取：值不要加引号，也不要在值后追加注释。
# 以下 localhost 适用于本机服务；虚拟机部署请改为可访问的虚拟机 IP。
SERVER_PORT=8081
DB_URL=jdbc:mysql://localhost:3306/docmind?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=

MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET_NAME=uploads
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_FILE_PROCESSING_TOPIC=file-processing
KAFKA_DLT_TOPIC=file-processing-dlt
KAFKA_LISTENER_CONCURRENCY=3

EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=2048
EMBEDDING_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_API_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
# 开启重排序前确认相应模型调用权限；默认复用 EMBEDDING_API_KEY。
RERANK_ENABLED=false
# 仅使用独立密钥时设置 RERANK_API_KEY，否则不设置此项。

# JWT 填写至少 32 字节随机密钥的 Base64 编码，管理员密码自行设置。
JWT_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PRIMARY_ORG=DEFAULT
ADMIN_ORG_TAGS=DEFAULT,admin
