{
  "mappings": {
    "properties": {
      "fileUploadId": {
        "type": "long"
      },
      "fileMd5": {
        "type": "keyword"
      },
      "fileName": {
        "type": "keyword"
      },
      "chunkId": {
        "type": "integer"
      },
      "sectionId": {
        "type": "long"
      },
      "textContent": {
